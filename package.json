{
	"name": "@paszed/foundation",
	"version": "0.1.0",
	"private": true,
	"description": "A production-ready engineering platform for building, bootstrapping, and maintaining modern TypeScript projects.",
	"license": "MIT",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "turbo run build",
		"clean": "turbo run clean && rimraf node_modules",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
		"format": "biome format . --write",
		"check": "biome check .",
		"publint": "publint",
		"sync": "syncpack lint",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "changeset publish"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@changesets/cli": "^3.0.0",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.2.0",
		"eslint": "^10.8.1",
		"eslint-config-next": "^16.3.1",
		"eslint-plugin-storybook": "^10.5.8",
		"globals": "^17.11.0",
		"npm-run-all": "^4.1.5",
		"publint": "^0.3.23",
		"rimraf": "^6.1.3",
		"syncpack": "^15.3.3",
		"tsx": "^4.23.12",
		"turbo": "^2.10.9",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.67.0"
	}
}
